import java.util.Scanner;

public class PopulationGrowth {

    // Method to calculate growth rate
    public static double growthRate(double x, double y) {
        return x - y;
    }

    // Method to calculate estimated population
    public static double estimatedPopulation(double c, double k, double z) {
        return (c - k) * z;
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // User inputs
        System.out.print("Enter Province Name: ");
        String province = input.nextLine();

        System.out.print("Enter District: ");
        String district = input.nextLine();

        System.out.print("Enter Starting Population (sp): ");
        double sp = input.nextDouble();

        System.out.print("Enter Birth Rate (br): ");
        double br = input.nextDouble();

        System.out.print("Enter Death Rate (dr): ");
        double dr = input.nextDouble();

        System.out.print("Enter Number of Years (N): ");
        double n = input.nextDouble();

        // Calculate current population
        double cp = sp + ((br * sp) / 100) - ((dr * sp) / 100);

        // Call methods
        double gr = growthRate(br, dr);
        double ep = estimatedPopulation(cp, gr, n);

        // Output results
        System.out.println("\n===== Population Report =====");
        System.out.println("Province: " + province);
        System.out.println("District: " + district);
        System.out.println("Starting Population: " + sp);
        System.out.println("Birth Rate: " + br);
        System.out.println("Death Rate: " + dr);
        System.out.println("Current Population: " + cp);
        System.out.println("Growth Rate: " + gr);
        System.out.println("Estimated Population after " + n + " years: " + ep);

        input.close();
    }
}
